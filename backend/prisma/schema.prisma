generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  TEACHER
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  taughtClasses       ClassGroup[]         @relation("TaughtClasses")
  parentLinks         StudentParent[]
  examAttempts        ExamAttempt[]
  gradedWritings      WritingSubmission[]  @relation("WritingGrader")
  gradedSpeakings     SpeakingSubmission[] @relation("SpeakingGrader")

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model ContactSubmission {
  id             String   @id @default(cuid())
  fullName       String   @map("full_name")
  phone          String
  email          String?
  courseInterest String   @map("course_interest")
  learningNeeds  String?  @map("learning_needs")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model ContactInformation {
  id        String   @id @default("contact")
  phone     String
  email     String
  address   String
  hours     String
  mapUrl    String   @map("map_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_information")
}

model CareerApplication {
  id           String   @id @default(cuid())
  jobId        String?  @map("job_id")
  fullName     String   @map("full_name")
  email        String
  phone        String
  position     String
  introduction String?
  createdAt    DateTime @default(now()) @map("created_at")

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("career_applications")
}

model Job {
  id              String     @id @default(cuid())
  title           String
  normalizedTitle String     @unique @map("normalized_title")
  type            String
  location        String
  salaryType      SalaryType @default(NEGOTIABLE) @map("salary_type")
  salaryMin       Int?       @map("salary_min")
  salaryMax       Int?       @map("salary_max")
  currency        String     @default("VND")
  duties          String[]
  benefits        String[]
  req             String
  sortOrder       Int        @unique @default(1) @map("sort_order")
  isPublished     Boolean    @default(true) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  careerApplications CareerApplication[]

  @@index([isPublished, sortOrder])
  @@map("jobs")
}

enum SalaryType {
  RANGE
  FIXED
  NEGOTIABLE
}

model Course {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String
  description   String
  level         String
  target        String
  tuition       String
  duration      String    @default("90 phút/buổi")
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  perks         String[]
  category      String
  coverImageUrl String    @map("cover_image_url")
  accent        String    @default("#F16522")
  bg            String    @default("#FFF4EC")
  icon          String    @default("📚")
  featured      Boolean   @default(true)
  sortOrder     Int       @default(0) @map("sort_order")
  isPublished   Boolean   @default(true) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  classGroups ClassGroup[]

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("courses")
}

model SuccessStory {
  id          String   @id @default(cuid())
  name        String
  course      String
  badge       String
  text        String
  stars       Int      @default(5)
  avatar      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("success_stories")
}

model GalleryImage {
  id             String   @id @default(cuid())
  imageUrl       String   @map("image_url")
  alt            String
  objectPosition String   @default("center") @map("object_position")
  sortOrder      Int      @default(0) @map("sort_order")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("gallery_images")
}

model FacilityImage {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("facility_images")
}

/// Singleton content for About page (vision image, etc.)
model AboutPageContent {
  id             String   @id @default("about")
  visionImageUrl String   @map("vision_image_url")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("about_page_content")
}

model Teacher {
  id          String   @id @default(cuid())
  name        String
  title       String
  cred        String
  exp         String
  imageUrl    String   @map("image_url")
  bio         String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("teachers")
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  publishedAt     DateTime @map("published_at") @db.Date
  readTimeMinutes Int      @map("read_time_minutes")
  coverImageUrl   String   @map("cover_image_url")
  featured        Boolean  @default(false)
  intro           String
  sections        Json
  takeaway        String
  isPublished     Boolean  @default(true) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("blog_posts")
}

enum StudentStatus {
  STUDYING
  PAUSED
  FINISHED
}

enum ClassStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
}

model Student {
  id          String        @id @default(cuid())
  fullName    String        @map("full_name")
  phone       String?
  email       String?
  parentName  String?       @map("parent_name")
  parentPhone String?       @map("parent_phone")
  status      StudentStatus @default(STUDYING)
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  enrollments Enrollment[]
  attendances AttendanceRecord[]
  parents     StudentParent[]
  invoices    TuitionInvoice[]

  @@index([status])
  @@index([fullName])
  @@map("students")
}

model ClassGroup {
  id           String      @id @default(cuid())
  name         String
  courseId     String?     @map("course_id")
  level        String?
  teacherId    String?     @map("teacher_id")
  scheduleDays Int[]       @map("schedule_days")
  startTime    String?     @map("start_time")
  endTime      String?     @map("end_time")
  startsOn     DateTime?   @map("starts_on") @db.Date
  endsOn       DateTime?   @map("ends_on") @db.Date
  room         String?
  capacity     Int?
  status       ClassStatus @default(OPEN)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher     User?          @relation("TaughtClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([status])
  @@index([teacherId])
  @@map("classes")
}

model Enrollment {
  id        String    @id @default(cuid())
  studentId String    @map("student_id")
  classId   String    @map("class_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
  @@map("enrollments")
}

model ClassSession {
  id        String   @id @default(cuid())
  classId   String   @map("class_id")
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  class       ClassGroup         @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]

  @@unique([classId, date])
  @@index([date])
  @@map("class_sessions")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  note      String?
  markedAt  DateTime         @default(now()) @map("marked_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model StudentParent {
  id           String   @id @default(cuid())
  parentUserId String   @map("parent_user_id")
  studentId    String   @map("student_id")
  createdAt    DateTime @default(now()) @map("created_at")

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([studentId])
  @@map("student_parents")
}

model TuitionInvoice {
  id              String        @id @default(cuid())
  studentId       String        @map("student_id")
  period          String
  amount          Int
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(UNPAID)
  note            String?
  paymentProofUrl String?       @map("payment_proof_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, period])
  @@index([status])
  @@index([dueDate])
  @@map("tuition_invoices")
}

// ─────────────────────────────────────────────────────────────
// Thi thử IELTS (Giai đoạn 4)
// L/R chấm tự động; W/S vào hàng chờ giáo viên chấm tay.
// ─────────────────────────────────────────────────────────────

enum ExamSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum ExamQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOTGIVEN
  YES_NO_NOTGIVEN
  MATCHING
  CLASSIFICATION
  MATCHING_PARAGRAPH
  NOTE_COMPLETION
  TABLE_COMPLETION
  SUMMARY_COMPLETION
  SENTENCE_COMPLETION
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum ExamGradingStatus {
  PENDING
  GRADED
}

/// Một đề thi thử theo 1 kỹ năng (hoặc gói nhiều đề ghép ở tầng ứng dụng).
model ExamTest {
  id              String    @id @default(cuid())
  code            String    @unique
  title           String
  skill           ExamSkill
  module          String? // "academic" | "general" (Reading)
  durationMinutes Int       @map("duration_minutes")
  audioUrl        String?   @map("audio_url") // Listening: 1 file / đề
  playOnce        Boolean   @default(true) @map("play_once")
  source          String?
  bandScale       Json?     @map("band_scale") // bảng quy đổi raw(0-40) -> band
  isPublished     Boolean   @default(false) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sections ExamSection[]
  attempts ExamAttempt[]

  @@index([skill])
  @@map("exam_tests")
}

/// Reading: 1 đoạn văn. Listening: 1 section (bối cảnh + transcript).
model ExamSection {
  id          String   @id @default(cuid())
  testId      String   @map("test_id")
  order       Int
  heading     String?
  passageText String?  @map("passage_text") // Reading: nội dung đoạn văn
  transcript  String? // Listening: lời thoại (hiện sau khi nộp)
  context     String? // Listening: audio nói về gì
  createdAt   DateTime @default(now()) @map("created_at")

  test   ExamTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  groups ExamQuestionGroup[]

  @@index([testId])
  @@map("exam_sections")
}

/// Nhóm câu hỏi cùng dạng (chia sẻ câu lệnh + danh sách lựa chọn nếu có).
model ExamQuestionGroup {
  id          String           @id @default(cuid())
  sectionId   String           @map("section_id")
  order       Int
  type        ExamQuestionType
  instruction String
  options     Json? // danh sách A/B/C dùng chung (matching, classification…)
  maxWords    Int?             @map("max_words") // giới hạn số từ cho câu điền
  createdAt   DateTime         @default(now()) @map("created_at")

  section   ExamSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]

  @@index([sectionId])
  @@map("exam_question_groups")
}

/// Một câu hỏi. correctAnswers: các biến thể chấp nhận (rỗng với đề W/S).
model ExamQuestion {
  id             String   @id @default(cuid())
  groupId        String   @map("group_id")
  no             Int // số câu 1..40 trong đề
  prompt         String
  options        Json? // lựa chọn riêng của câu (MCQ A-D)
  correctAnswers String[] @map("correct_answers")
  explanation    String?
  createdAt      DateTime @default(now()) @map("created_at")

  group   ExamQuestionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  answers ExamAttemptAnswer[]

  @@index([groupId])
  @@map("exam_questions")
}

/// Một lượt làm bài của học viên. startedAt là mốc giờ chuẩn ở server.
model ExamAttempt {
  id          String            @id @default(cuid())
  testId      String            @map("test_id")
  userId      String            @map("user_id")
  status      ExamAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime          @default(now()) @map("started_at") // nguồn đồng hồ đếm giờ
  submittedAt DateTime?         @map("submitted_at")
  rawScore    Int?              @map("raw_score") // số câu đúng (L/R)
  band        String? // band quy đổi
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  test     ExamTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  ExamAttemptAnswer[]
  writing  WritingSubmission?
  speaking SpeakingSubmission?

  @@index([userId])
  @@index([testId])
  @@map("exam_attempts")
}

/// Đáp án học viên cho từng câu — autosave liên tục, chấm khi nộp (L/R).
model ExamAttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String   @map("attempt_id")
  questionId String   @map("question_id")
  value      String? // đáp án đã chọn/gõ
  isCorrect  Boolean? @map("is_correct") // set lúc nộp
  updatedAt  DateTime @updatedAt @map("updated_at")

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_attempt_answers")
}

/// Bài Writing của học viên — giáo viên chấm tay + đính bài mẫu.
model WritingSubmission {
  id           String            @id @default(cuid())
  attemptId    String            @unique @map("attempt_id")
  responseText String            @map("response_text")
  status       ExamGradingStatus @default(PENDING)
  band         String?
  feedback     String?
  sampleAnswer String?           @map("sample_answer")
  gradedById   String?           @map("graded_by_id")
  gradedAt     DateTime?         @map("graded_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  gradedBy User?       @relation("WritingGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("exam_writing_submissions")
}

/// Bài Speaking — audio upload thẳng lên Cloudinary; giáo viên nghe & chấm.
model SpeakingSubmission {
  id         String            @id @default(cuid())
  attemptId  String            @unique @map("attempt_id")
  audioUrl   String            @map("audio_url")
  status     ExamGradingStatus @default(PENDING)
  band       String?
  feedback   String?
  gradedById String?           @map("graded_by_id")
  gradedAt   DateTime?         @map("graded_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  gradedBy User?       @relation("SpeakingGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("exam_speaking_submissions")
}
