generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model ContactSubmission {
  id             String   @id @default(cuid())
  fullName       String   @map("full_name")
  phone          String
  email          String?
  courseInterest String   @map("course_interest")
  learningNeeds  String?  @map("learning_needs")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model ContactInformation {
  id        String   @id @default("contact")
  phone     String
  email     String
  address   String
  hours     String
  mapUrl    String   @map("map_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_information")
}

model CareerApplication {
  id           String   @id @default(cuid())
  jobId        String?  @map("job_id")
  fullName     String   @map("full_name")
  email        String
  phone        String
  position     String
  introduction String?
  createdAt    DateTime @default(now()) @map("created_at")

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("career_applications")
}

model Job {
  id              String   @id @default(cuid())
  title           String
  normalizedTitle String   @unique @map("normalized_title")
  type            String
  location        String
  salary          String
  duties          String[]
  benefits        String[]
  req             String
  sortOrder       Int      @default(0) @map("sort_order")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  careerApplications CareerApplication[]

  @@index([isPublished, sortOrder])
  @@map("jobs")
}

model Course {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  subtitle       String
  description    String
  level          String
  target         String
  tuition        String
  duration       String   @default("90 phút/buổi")
  perks          String[]
  category       String
  coverImageUrl  String   @map("cover_image_url")
  accent         String   @default("#F16522")
  bg             String   @default("#FFF4EC")
  icon           String   @default("📚")
  featured       Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("courses")
}

model SuccessStory {
  id          String   @id @default(cuid())
  name        String
  course      String
  badge       String
  text        String
  stars       Int      @default(5)
  avatar      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("success_stories")
}

model GalleryImage {
  id             String   @id @default(cuid())
  imageUrl       String   @map("image_url")
  alt            String
  objectPosition String   @default("center") @map("object_position")
  sortOrder      Int      @default(0) @map("sort_order")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("gallery_images")
}

model FacilityImage {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("facility_images")
}

/// Singleton content for About page (vision image, etc.)
model AboutPageContent {
  id             String   @id @default("about")
  visionImageUrl String   @map("vision_image_url")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("about_page_content")
}

model Teacher {
  id          String   @id @default(cuid())
  name        String
  title       String
  cred        String
  exp         String
  imageUrl    String   @map("image_url")
  bio         String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("teachers")
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  publishedAt     DateTime @map("published_at") @db.Date
  readTimeMinutes Int      @map("read_time_minutes")
  coverImageUrl   String   @map("cover_image_url")
  featured        Boolean  @default(false)
  intro           String
  sections        Json
  takeaway        String
  isPublished     Boolean  @default(true) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("blog_posts")
}
