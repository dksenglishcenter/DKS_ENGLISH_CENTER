generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  TEACHER
  PARENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  taughtClasses       ClassGroup[]         @relation("TaughtClasses")
  parentLinks         StudentParent[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model ContactSubmission {
  id             String   @id @default(cuid())
  fullName       String   @map("full_name")
  phone          String
  email          String?
  courseInterest String   @map("course_interest")
  learningNeeds  String?  @map("learning_needs")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model ContactInformation {
  id        String   @id @default("contact")
  phone     String
  email     String
  address   String
  hours     String
  mapUrl    String   @map("map_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_information")
}

model CareerApplication {
  id           String   @id @default(cuid())
  jobId        String?  @map("job_id")
  fullName     String   @map("full_name")
  email        String
  phone        String
  position     String
  introduction String?
  createdAt    DateTime @default(now()) @map("created_at")

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("career_applications")
}

model Job {
  id              String   @id @default(cuid())
  title           String
  normalizedTitle String   @unique @map("normalized_title")
  type            String
  location        String
  salaryType      SalaryType @default(NEGOTIABLE) @map("salary_type")
  salaryMin       Int?       @map("salary_min")
  salaryMax       Int?       @map("salary_max")
  currency        String     @default("VND")
  duties          String[]
  benefits        String[]
  req             String
  sortOrder       Int      @unique @default(1) @map("sort_order")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  careerApplications CareerApplication[]

  @@index([isPublished, sortOrder])
  @@map("jobs")
}

enum SalaryType {
  RANGE
  FIXED
  NEGOTIABLE
}

model Course {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  subtitle       String
  description    String
  level          String
  target         String
  tuition        String
  duration       String   @default("90 phút/buổi")
  perks          String[]
  category       String
  coverImageUrl  String   @map("cover_image_url")
  accent         String   @default("#F16522")
  bg             String   @default("#FFF4EC")
  icon           String   @default("📚")
  featured       Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  classGroups ClassGroup[]

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("courses")
}

model SuccessStory {
  id          String   @id @default(cuid())
  name        String
  course      String
  badge       String
  text        String
  stars       Int      @default(5)
  avatar      String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("success_stories")
}

model GalleryImage {
  id             String   @id @default(cuid())
  imageUrl       String   @map("image_url")
  alt            String
  objectPosition String   @default("center") @map("object_position")
  sortOrder      Int      @default(0) @map("sort_order")
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("gallery_images")
}

model FacilityImage {
  id          String   @id @default(cuid())
  imageUrl    String   @map("image_url")
  title       String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("facility_images")
}

/// Singleton content for About page (vision image, etc.)
model AboutPageContent {
  id             String   @id @default("about")
  visionImageUrl String   @map("vision_image_url")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("about_page_content")
}

model Teacher {
  id          String   @id @default(cuid())
  name        String
  title       String
  cred        String
  exp         String
  imageUrl    String   @map("image_url")
  bio         String
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("teachers")
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  publishedAt     DateTime @map("published_at") @db.Date
  readTimeMinutes Int      @map("read_time_minutes")
  coverImageUrl   String   @map("cover_image_url")
  featured        Boolean  @default(false)
  intro           String
  sections        Json
  takeaway        String
  isPublished     Boolean  @default(true) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([featured, isPublished, sortOrder])
  @@map("blog_posts")
}

enum StudentStatus {
  STUDYING
  PAUSED
  FINISHED
}

enum ClassStatus {
  OPEN
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
}

model Student {
  id          String        @id @default(cuid())
  fullName    String        @map("full_name")
  phone       String?
  email       String?
  parentName  String?       @map("parent_name")
  parentPhone String?       @map("parent_phone")
  status      StudentStatus @default(STUDYING)
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  enrollments Enrollment[]
  attendances AttendanceRecord[]
  parents     StudentParent[]
  invoices    TuitionInvoice[]

  @@index([status])
  @@index([fullName])
  @@map("students")
}

model ClassGroup {
  id           String      @id @default(cuid())
  name         String
  courseId     String?     @map("course_id")
  level        String?
  teacherId    String?     @map("teacher_id")
  scheduleDays Int[]       @map("schedule_days")
  startTime    String?     @map("start_time")
  endTime      String?     @map("end_time")
  room         String?
  capacity     Int?
  status       ClassStatus @default(OPEN)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  course      Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher     User?           @relation("TaughtClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  sessions    ClassSession[]

  @@index([status])
  @@index([teacherId])
  @@map("classes")
}

model Enrollment {
  id        String    @id @default(cuid())
  studentId String    @map("student_id")
  classId   String    @map("class_id")
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([classId])
  @@map("enrollments")
}

model ClassSession {
  id        String   @id @default(cuid())
  classId   String   @map("class_id")
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  class       ClassGroup         @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]

  @@unique([classId, date])
  @@index([date])
  @@map("class_sessions")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  status    AttendanceStatus @default(PRESENT)
  note      String?
  markedAt  DateTime         @default(now()) @map("marked_at")

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model StudentParent {
  id           String   @id @default(cuid())
  parentUserId String   @map("parent_user_id")
  studentId    String   @map("student_id")
  createdAt    DateTime @default(now()) @map("created_at")

  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([studentId])
  @@map("student_parents")
}

model TuitionInvoice {
  id        String        @id @default(cuid())
  studentId String        @map("student_id")
  period    String
  amount    Int
  dueDate   DateTime      @map("due_date") @db.Date
  status    InvoiceStatus @default(UNPAID)
  note      String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, period])
  @@index([status])
  @@index([dueDate])
  @@map("tuition_invoices")
}
