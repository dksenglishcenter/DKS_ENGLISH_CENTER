PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL — lấy từ Supabase Dashboard > Project Settings > Database
# Transaction pooler (port 6543) — dùng cho app runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — dùng cho migrate
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Cloudflare R2 — Storage & Databases > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
