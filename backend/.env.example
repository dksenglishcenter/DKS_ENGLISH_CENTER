PORT=3001
FRONTEND_URL=http://localhost:3000

# Production (Vercel + Render): set URL FE thật để CORS
# FRONTEND_URL=https://dks-english-center-frontend-delta.vercel.app
# COOKIE_SAME_SITE=none

# Supabase PostgreSQL — lấy từ Supabase Dashboard > Project Settings > Database
# Transaction pooler (port 6543) — dùng cho app runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — dùng cho migrate
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Cloudinary — Dashboard > Product environment credentials
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Auth JWT (đổi secret production)
JWT_SECRET=change-me-to-a-long-random-string

# --- Email (Nodemailer + Gmail SMTP) ---
# Render Free chặn outbound SMTP 587 — cần paid Render hoặc host khác.
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="DKS English Center <your.gmail@gmail.com>"
NOTIFY_EMAIL=admin-inbox@gmail.com

# Zalo hỗ trợ quên mật khẩu
ZALO_CONTACT_URL=https://zalo.me/0834513456
ZALO_CONTACT_PHONE=0834513456

# Sau khi cấu hình DATABASE_URL + DIRECT_URL:
# npm run db:migrate
# npm run db:seed   ← admin nằm trong prisma/seed.ts

# --- Feature flags (bật/tắt tính năng; để trống hoặc khác "true" = TẮT) ---
# Production để trống để ẩn tính năng chưa ra mắt; local đặt =true để phát triển.
FEATURE_MOCK_TEST=false
FEATURE_PHASE3=false
