PORT=3001
FRONTEND_URL=http://localhost:3000

# Production (Vercel + Render): set URL FE thật để CORS
# FRONTEND_URL=https://dks-english-center-frontend-delta.vercel.app
# COOKIE_SAME_SITE=none

# Supabase PostgreSQL — lấy từ Supabase Dashboard > Project Settings > Database
# Transaction pooler (port 6543) — dùng cho app runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — dùng cho migrate
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Cloudinary — Dashboard > Product environment credentials
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Auth JWT (đổi secret production)
JWT_SECRET=change-me-to-a-long-random-string

# --- Email notify (form Liên hệ + Tuyển dụng) ---
# Thiếu config → form vẫn lưu DB, chỉ bỏ gửi mail.
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="DKS English Center <your.gmail@gmail.com>"
# Một hoặc nhiều email admin nhận notify (hộp thư đến của bạn)
NOTIFY_EMAIL=your.personal@gmail.com
# Hệ thống cũng gửi email xác nhận tới người nộp form (nếu họ điền email)

# Sau khi cấu hình DATABASE_URL + DIRECT_URL:
# npm run db:migrate
# npm run db:seed   ← admin nằm trong prisma/seed.ts
